#
# Makefile pre Players - Unifikovany program pre spracovanie hracov
#
# Kompilacia: make -f Makefile_Players
# Spustenie: ./Players CS|DE|PL|FR|ALL
#
# Author: Boris Fekar
# Date: 2025-11-19
#

# Compiler a flagy
CXX = g++
CXXFLAGS = -std=c++17 -Wall -Wextra -O2 -I. -I/usr/include/postgresql
LDFLAGS = -lpq -lcurl -lpthread

# Adresare
OBJDIR = obj
BINDIR = bin
LIBDIR = lib

# Vytvor adresare ak neexistuju
$(shell mkdir -p $(OBJDIR) $(BINDIR))

# Cielovy program
TARGET = $(BINDIR)/Players

# Zdrojove subory
MAIN_SRC = Players.cpp
LIB_SRCS = $(LIBDIR)/Pgsql.cpp \
           $(LIBDIR)/SendCurl.cpp \
           $(LIBDIR)/QueryBuilder.cpp \
           $(LIBDIR)/PlayerProcessor.cpp

# Objektove subory
MAIN_OBJ = $(OBJDIR)/Players.o
LIB_OBJS = $(OBJDIR)/Pgsql.o \
           $(OBJDIR)/SendCurl.o \
           $(OBJDIR)/QueryBuilder.o \
           $(OBJDIR)/PlayerProcessor.o

# Vsetky objektove subory
OBJS = $(MAIN_OBJ) $(LIB_OBJS)

# Hlavicky
HEADERS = $(LIBDIR)/Pgsql.h \
          $(LIBDIR)/SendCurl.h \
          $(LIBDIR)/QueryBuilder.h \
          $(LIBDIR)/PlayerProcessor.h

# Hlavny ciel
all: $(TARGET)

# Linkovanie
$(TARGET): $(OBJS)
	@echo "Linkovanie: $@"
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS)
	@echo "Kompilacia dokoncena: $@"
	@echo ""
	@echo "Spustenie:"
	@echo "  ./$(TARGET) CS   - Ceske a Slovenske klany"
	@echo "  ./$(TARGET) DE   - Nemecke klany"
	@echo "  ./$(TARGET) PL   - Polske klany"
	@echo "  ./$(TARGET) FR   - Francuzske klany"
	@echo "  ./$(TARGET) ALL  - Vsetky ostatne klany"

# Kompilacia hlavneho programu
$(OBJDIR)/Players.o: $(MAIN_SRC) $(HEADERS)
	@echo "Kompilujem: $<"
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Kompilacia kniznic
$(OBJDIR)/Pgsql.o: $(LIBDIR)/Pgsql.cpp $(LIBDIR)/Pgsql.h
	@echo "Kompilujem: $<"
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(OBJDIR)/SendCurl.o: $(LIBDIR)/SendCurl.cpp $(LIBDIR)/SendCurl.h
	@echo "Kompilujem: $<"
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(OBJDIR)/QueryBuilder.o: $(LIBDIR)/QueryBuilder.cpp $(LIBDIR)/QueryBuilder.h
	@echo "Kompilujem: $<"
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(OBJDIR)/PlayerProcessor.o: $(LIBDIR)/PlayerProcessor.cpp $(LIBDIR)/PlayerProcessor.h \
                              $(LIBDIR)/SendCurl.h $(LIBDIR)/Pgsql.h
	@echo "Kompilujem: $<"
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Cistenie
clean:
	@echo "Cistenie objektovych suborov..."
	rm -f $(OBJDIR)/*.o
	@echo "Hotovo"

# Uplne cistenie (vratane biniek)
distclean: clean
	@echo "Cistenie binarnych suborov..."
	rm -f $(TARGET)
	@echo "Hotovo"

# Rebuild
rebuild: distclean all

# Info
info:
	@echo "==================================="
	@echo "Players - Informacie o projekte"
	@echo "==================================="
	@echo "Compiler:    $(CXX)"
	@echo "C++ Standard: C++17"
	@echo "Flags:       $(CXXFLAGS)"
	@echo "Libraries:   $(LDFLAGS)"
	@echo "Target:      $(TARGET)"
	@echo ""
	@echo "Prikazy:"
	@echo "  make -f Makefile_Players        - Kompilacia"
	@echo "  make -f Makefile_Players clean  - Vymazanie .o suborov"
	@echo "  make -f Makefile_Players distclean - Vymazanie vsetkeho"
	@echo "  make -f Makefile_Players rebuild - Rebuild projektu"
	@echo "  make -f Makefile_Players info    - Tato informacia"

.PHONY: all clean distclean rebuild info
