# Moderný Makefile pre PlayersWN8v2 s optimalizáciou

# Compiler a flagy
CXX := g++
CXXFLAGS := -std=c++17 -Wall -Wextra -O3 -march=native -flto
CXXFLAGS += -I/usr/include/postgresql -fPIC

# Linker flagy
LDFLAGS := -L/usr/lib/x86_64-linux-gnu
LDLIBS := -lpq -lcurl -lpthread

# Adresáre
SRCDIR := .
LIBDIR := ./lib
BINDIR := ./bin
OBJDIR := ./obj

# Súbory
TARGET := $(BINDIR)/PlayersWN8v2
SOURCES := PlayersWN8v2.cpp
LIB_SOURCES := $(LIBDIR)/Pgsql.cpp $(LIBDIR)/SendCurl.cpp \
               $(LIBDIR)/GetPlayersStats.cpp $(LIBDIR)/GetPlayersVehicles.cpp

OBJECTS := $(OBJDIR)/PlayersWN8v2.o
LIB_OBJECTS := $(OBJDIR)/Pgsql.o $(OBJDIR)/SendCurl.o \
               $(OBJDIR)/GetPlayersStats.o $(OBJDIR)/GetPlayersVehicles.o

ALL_OBJECTS := $(OBJECTS) $(LIB_OBJECTS)

# Detekcia počtu jadier pre paralelný build
NPROCS := $(shell nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 1)
MAKEFLAGS += -j$(NPROCS)

# Hlavný cieľ
all: $(TARGET)

# Vytvorenie adresárov
$(OBJDIR) $(BINDIR):
	@mkdir -p $@

# Linkovanie
$(TARGET): $(ALL_OBJECTS) | $(BINDIR)
	@echo "Linking $@..."
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $(ALL_OBJECTS) $(LDLIBS)
	@echo "Build complete: $@"

# Kompilácia hlavného súboru
$(OBJDIR)/PlayersWN8v2.o: PlayersWN8v2.cpp | $(OBJDIR)
	@echo "Compiling $<..."
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Kompilácia knižníc
$(OBJDIR)/%.o: $(LIBDIR)/%.cpp $(LIBDIR)/%.h | $(OBJDIR)
	@echo "Compiling $<..."
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Pravidlá pre čistenie
clean:
	@echo "Cleaning object files..."
	rm -f $(OBJDIR)/*.o

distclean: clean
	@echo "Cleaning binaries..."
	rm -f $(TARGET)

# Rebuild - kompletné prekompilovanie
rebuild: distclean all

# Spustenie programu
run: $(TARGET)
	@echo "Running $(TARGET)..."
	@$(TARGET)

# Debug build
debug: CXXFLAGS := -std=c++17 -Wall -Wextra -g -O0 -I/usr/include/postgresql -fPIC
debug: clean $(TARGET)

# Profiling build
profile: CXXFLAGS += -pg
profile: LDFLAGS += -pg
profile: clean $(TARGET)

# Inštalácia
install: $(TARGET)
	@echo "Installing to /usr/local/bin..."
	install -m 755 $(TARGET) /usr/local/bin/

# Help
help:
	@echo "Makefile pre PlayersWN8v2"
	@echo ""
	@echo "Použitie:"
	@echo "  make          - Kompiluje program (optimalizovaná verzia)"
	@echo "  make debug    - Kompiluje debug verziu"
	@echo "  make profile  - Kompiluje verziu pre profilovanie"
	@echo "  make clean    - Vymaže objektové súbory"
	@echo "  make distclean- Vymaže všetky generované súbory"
	@echo "  make rebuild  - Kompletne prekompiluje program"
	@echo "  make run      - Skompiluje a spustí program"
	@echo "  make install  - Nainštaluje do /usr/local/bin"
	@echo ""
	@echo "Paralelizácia: Používa $(NPROCS) jadier"

# Phony ciele
.PHONY: all clean distclean rebuild run debug profile install help

# Závislosti
$(OBJDIR)/PlayersWN8v2.o: PlayersWN8v2.cpp \
	$(LIBDIR)/Pgsql.h $(LIBDIR)/GetPlayersStats.h $(LIBDIR)/GetPlayersVehicles.h
$(OBJDIR)/Pgsql.o: $(LIBDIR)/Pgsql.cpp $(LIBDIR)/Pgsql.h
$(OBJDIR)/SendCurl.o: $(LIBDIR)/SendCurl.cpp $(LIBDIR)/SendCurl.h
$(OBJDIR)/GetPlayersStats.o: $(LIBDIR)/GetPlayersStats.cpp $(LIBDIR)/GetPlayersStats.h
$(OBJDIR)/GetPlayersVehicles.o: $(LIBDIR)/GetPlayersVehicles.cpp $(LIBDIR)/GetPlayersVehicles.h
