#
# Makefile pre PlayersInfo2 - Spracovanie informacii o hracoch
#
# Kompilacia: make -f Makefile_PlayersInfo2
# Spustenie: ./bin/PlayersInfo2
#
# Author: Boris Fekar
# Date: 2026-02-28
#

# Compiler a flagy
CXX = g++
JSON_INCLUDE = ./json/include
CXXFLAGS = -std=c++17 -Wall -Wextra -O2 -I. -I/usr/include/postgresql -I$(JSON_INCLUDE)
LDFLAGS = -lpq -lcurl

# Adresare
OBJDIR = obj
BINDIR = bin
LIBDIR = lib

# Vytvor adresare ak neexistuju
$(shell mkdir -p $(OBJDIR) $(BINDIR))

# Cielovy program
TARGET = $(BINDIR)/PlayersInfo2

# Zdrojove subory
MAIN_SRC = PlayersInfo2.cpp
LIB_SRCS = $(LIBDIR)/Pgsql.cpp \
           $(LIBDIR)/SendCurl.cpp

# Objektove subory
MAIN_OBJ = $(OBJDIR)/PlayersInfo2.o
LIB_OBJS = $(OBJDIR)/Pgsql.o \
           $(OBJDIR)/SendCurl.o

# Vsetky objektove subory
OBJS = $(MAIN_OBJ) $(LIB_OBJS)

# Hlavicky
HEADERS = $(LIBDIR)/Pgsql.h \
          $(LIBDIR)/SendCurl.h

# Hlavny ciel
all: $(TARGET)

# Linkovanie
$(TARGET): $(OBJS)
	@echo "Linkovanie: $@"
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS)
	@echo "Kompilacia dokoncena: $@"
	@echo ""
	@echo "Spustenie:"
	@echo "  ./$(TARGET)"

# Kompilacia hlavneho programu
$(OBJDIR)/PlayersInfo2.o: $(MAIN_SRC) $(HEADERS)
	@echo "Kompilujem: $<"
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Kompilacia kniznic
$(OBJDIR)/Pgsql.o: $(LIBDIR)/Pgsql.cpp $(LIBDIR)/Pgsql.h
	@echo "Kompilujem: $<"
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(OBJDIR)/SendCurl.o: $(LIBDIR)/SendCurl.cpp $(LIBDIR)/SendCurl.h
	@echo "Kompilujem: $<"
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Cistenie
clean:
	@echo "Cistenie objektovych suborov..."
	rm -f $(OBJDIR)/*.o
	@echo "Hotovo"

# Uplne cistenie (vratane biniek)
distclean: clean
	@echo "Cistenie binarnych suborov..."
	rm -f $(TARGET)
	@echo "Hotovo"

# Rebuild
rebuild: distclean all

# Info
info:
	@echo "==================================="
	@echo "PlayersInfo2 - Informacie o projekte"
	@echo "==================================="
	@echo "Compiler:    $(CXX)"
	@echo "C++ Standard: C++17"
	@echo "Flags:       $(CXXFLAGS)"
	@echo "Libraries:   $(LDFLAGS)"
	@echo "Target:      $(TARGET)"
	@echo ""
	@echo "Prikazy:"
	@echo "  make -f Makefile_PlayersInfo2        - Kompilacia"
	@echo "  make -f Makefile_PlayersInfo2 clean  - Vymazanie .o suborov"
	@echo "  make -f Makefile_PlayersInfo2 distclean - Vymazanie vsetkeho"
	@echo "  make -f Makefile_PlayersInfo2 rebuild - Rebuild projektu"
	@echo "  make -f Makefile_PlayersInfo2 info    - Tato informacia"

.PHONY: all clean distclean rebuild info
